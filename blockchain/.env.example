# ============================================================
# UniRent Blockchain – Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# MST Testnet
MST_RPC_URL=https://testnetrpc.mstblockchain.com
MST_CHAIN_ID=4545

# Deployer wallet private key (without 0x prefix)
# Get tMSTC from https://faucet.masterstroke.academy
DEPLOYER_PRIVATE_KEY=your_private_key_here

# Optional: Etherscan-compatible API key for contract verification on mstscan.com
# Leave blank if not available
MSTSCAN_API_KEY=
